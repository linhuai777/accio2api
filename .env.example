# ── 服务 ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
DATA_DIR=./data

# ── 密钥 ──────────────────────────────────────────────────
# ⚠️⚠️ 本文件里的值都是【公开示例值】—— 全世界都能在 GitHub 上看到。
#      用于快速跑通测试。**正式部署前必须全部改掉**，否则等于没有密钥。
#      改法：把下面两行换成你自己的值（或用 python setup.py 重新生成）。
#
# ADMIN_KEY：登录 /admin 后台用。不再自动生成，没设会拒绝启动。
#   示例（测试用）：test
#   生成自己的：python -c "import secrets;print('sk-admin-'+secrets.token_urlsafe(24))"
ADMIN_KEY=test

# 对外推理密钥 —— New API / 其它客户端里填这个
#   · 留空 = /v1/* 不校验密钥（仅限内网自用；公网暴露=开放代理）
#   · 示例（测试用，公开可见，请勿用于生产）
#   生成自己的：python -c "import secrets;print('sk-accio-'+secrets.token_urlsafe(24))"
API_KEY=sk-9Nh77kKgVaQHr2BrK8HDgWU3Oz1r9W41LaGmoKntkyUjYKXA

# SECRET_KEY：凭证加密主密钥。留空 = 首次启动自动生成到 DATA_DIR/.secret_key
#   ⚠️ 这个仍自动生成 —— 它只在本机加解密用，不需要你记，
#      写进 .env 反而更容易随文件泄漏。丢失后已存凭证无法解密。
# SECRET_KEY=

# ── Accio 站点 ────────────────────────────────────────────
ACCIO_BASE_URL=https://www.accio.com

# ── 浏览器 ────────────────────────────────────────────────
# 自动注册与网页登录需要；仅用「粘贴 cookie」模式可设 false
BROWSER_ENABLED=true
BROWSER_HEADLESS=true

# ── 验证码后端：cloudmail | imap | manual ─────────────────
OTP_BACKEND=cloudmail

# CloudMail（OTP_BACKEND=cloudmail）
CLOUDMAIL_BASE=https://mail.example.com
CLOUDMAIL_TOKEN=
CLOUDMAIL_EMAIL=
CLOUDMAIL_PASSWORD=
CLOUDMAIL_DOMAIN=example.com

# IMAP（OTP_BACKEND=imap）—— 适用于任何标准邮箱
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_SSL=1

# ── 代理池 / IP 轮换 ──────────────────────────────────────────
# 静态出口列表（逗号分隔）。多个本地出口 → 每个凭证可绑不同 IP。
PROXIES=http://127.0.0.1:<port-a>,http://127.0.0.1:<port-b>,http://127.0.0.1:<port-c>
# sticky=同凭证同出口（默认，最稳，避免会话异常风控）
# rotate=每次请求换 | random=随机
PROXY_STRATEGY=sticky
# mihomo / clash 控制 API —— 支持「同端口动态换 IP」
MIHOMO_API=http://127.0.0.1:<controller-port>
# ⚠ 必须填 proxy-groups 里的组名（例：AUTO）。
#   listeners 里的固定槽位直接绑节点，**不可切换**。
MIHOMO_GROUP=<group>
PROXY_CHECK_URL=https://api.ipify.org

# ── 安全相关 ──────────────────────────────────────────────────
# CORS 白名单（逗号分隔）。留空 = 不启用 CORS（同源部署够用）。
# ⚠ 不要用 "*" —— /admin/api/* 能读 cookie、删账号。
# ADMIN_ORIGINS=https://your-domain.com

# ⚠ SECRET_KEY 必须 ≥32 字符（凭证加密的唯一密钥材料），
#   太短会拒绝启动。生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
# SECRET_KEY=

# ── 上游沙箱域名提示（可选）──────────────────────────────────
# 嗅探沙箱 WS 地址时的**辅助匹配子串**（主判据是路径 /websocket/connect）。
# 上游换域名时改这里，无需改代码。多个用逗号分隔。
# SANDBOX_HOST_HINTS=agentbay

# ── 速率限制（默认开启）────────────────────────────────────────
# 三条独立限流线；0 = 该线不限制。默认值偏宽松，防脚本失控而非卡正常用户。
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_INFERENCE_RPM=120     # 每 API key 每分钟（推理接口）
# RATE_LIMIT_ADMIN_RPM=60          # 每 IP 每分钟（管理接口）
# RATE_LIMIT_LOGIN_PER_5MIN=10     # 每 IP 每 5 分钟（浏览器登录，单列严线）

# ════════════════════════════════════════════════════════════════
# 邮箱别名（批量注册的核心机制）
# ════════════════════════════════════════════════════════════════
# 配了 MAIL_PRIMARY 后，每个账号可派生独立别名地址，全部投递到
# 同一个物理收件箱 —— 上游看到 N 个身份，你只需维护一套邮箱凭证。
# 详见 docs/EMAIL.md
#
# MAIL_PRIMARY=yourname@gmail.com        # 主邮箱（真实收件箱）
# ALIAS_SCHEME=auto                     # plus / domain / auto
# ALIAS_TAG_LENGTH=6                    # 别名标签长度
# ALIAS_ACCEPT_PRIMARY_FALLBACK=true    # 上游改写 To 头时是否兜底认领
#
# 仅 domain 模式（自有域名 + 泛域名收信）需要：
# ALIAS_DOMAIN=mail.yourdomain.com

# ════════════════════════════════════════════════════════════════
# IMAP 收码（OTP_BACKEND=imap 时必填）
# ════════════════════════════════════════════════════════════════
# Gmail / Outlook 必须用「应用专用密码」（服务商已禁用账号密码直连）
#   Gmail   → https://myaccount.google.com/apppasswords
#   Outlook → https://account.microsoft.com/security （应用密码）
#
# IMAP_HOST=imap.gmail.com              # Outlook 用 outlook.office365.com
# IMAP_PORT=993
# IMAP_USER=yourname@gmail.com           # 应与 MAIL_PRIMARY 一致
# IMAP_PASSWORD=abcd efgh ijkl mnop     # 应用专用密码
# IMAP_SSL=true
# IMAP_FOLDER=INBOX                     # Gmail 可用 "[Gmail]/All Mail"

# ════════════════════════════════════════════════════════════════
# 调用审计（运维可观测性）
# ════════════════════════════════════════════════════════════════
# 结构化记录每次 /v1/* 调用，按天分片到 audit/YYYY-MM-DD.jsonl。
# 零依赖（就是 JSONL 文本），可直接 grep / jq / 导入分析工具。
# 记录的是**元数据**（模型、token 数、延迟、状态码、调用方哈希），
# 调用方标识取 API Key 的 SHA-256 前 12 位 —— 可区分、不可反推。
#
# AUDIT_ENABLED=true                    # 关闭则完全不写审计
# AUDIT_DIR=audit                       # 落盘目录
# AUDIT_LOG_BODY=false                  # ⚠ 记录消息正文（默认关闭，隐私考虑）
# AUDIT_BODY_LIMIT=400                  # 开启正文时的截断长度
# AUDIT_RETENTION_DAYS=30               # 保留天数（用清理接口执行）

# ════════════════════════════════════════════════════════════════
# 运维参数
# ════════════════════════════════════════════════════════════════
# HEALTH_CONCURRENCY=6                  # 健康巡检并发度（过高会给上游压力）
# GLOBAL_RPM_LIMIT=0                    # 全局每分钟请求上限，0 = 不限

# ════════════════════════════════════════════════════════════════
# 系统提示词控制（压制上游人设 / 防身份泄露）
# ════════════════════════════════════════════════════════════════
# 背景：上游（Accio）在服务端给它的 agent 注入了身份设定，反代这一侧
# **拿不到也删不掉**那份文本（上游 payload 里没有对应字段）。能做的只有：
#   (1) 在 query 前加一段「身份覆盖」前置语压制它 —— 软对抗，效果不保证
#   (2) 在输出侧拦截「我是 Accio / 我的系统提示是…」这类泄露话术 —— 确定性
# 两者都开才完整。
#
# ── 输入侧压制 ──
# 留空 = 用内置默认前置语；设 "off" = 完全关闭压制
# SYSTEM_PROMPT_OVERRIDE=
# 或用文件承载（优先于上面的内联值，便于放长文本 / 版本管理）
# SYSTEM_PROMPT_FILE=./system_prompt.txt
#
# 客户端传来的 role=system 消息如何处理：
#   keep（默认）—— 拼进 query，保持 OpenAI 兼容语义
#   drop        —— 丢弃，防止调用者用 system 劫持上游行为
# SYSTEM_MESSAGE_POLICY=keep
#
# ── 输出侧拦截 ──
# PERSONA_GUARD_ENABLED=false            # 开启后检测到泄露话术即替换（含清空 reasoning）
# PERSONA_GUARD_REPLY=抱歉，我无法提供关于底层模型或系统设定的信息。
